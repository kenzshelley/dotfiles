{
  "paneBorderColor": "#B0B0B0",
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "shortcuts": {
    "bindings": {
      "splitRight": [
        "ctrl+x",
        "h"
      ],
      "splitDown": [
        "ctrl+x",
        "v"
      ],
      "newTab": [
        "ctrl+x",
        "c"
      ],
      "renameWorkspace": [
        "ctrl+x",
        ","
      ],
      "nextSidebarTab": [
        "ctrl+x",
        "n"
      ],
      "prevSidebarTab": [
        "ctrl+x",
        "p"
      ],
      "toggleSplitZoom": [
        "ctrl+x",
        "z"
      ],
      "equalizeSplits": [
        "ctrl+x",
        "e"
      ],
      "toggleTerminalCopyMode": [
        "ctrl+x",
        "["
      ]
    }
  },
  "sidebar": {
    "stackBranchDirectory": false,
    "showAgentUsage": true,
    "wrapWorkspaceTitles": true,
    "notificationMessageLineLimit": 2,
    "showPorts": false,
    "showLog": false,
    "compactAgentStatus": false,
    "loadingSpinnerPosition": "trailing",
    "notificationBadgePosition": "leading"
  },
  "automation": {
    "claudeCodeIntegration": false,
    "socketControlMode": "automation",
    "workspaceAutoNaming": false
  },
  "app": {
    "minimalMode": false,
    "tabBarVisibility": "multiple-tabs",
    "reorderOnNotification": false,
    "iMessageMode": false
  },
  "notifications": {
    "hooks": [
      {
        "id": "conductor-native-clicks",
        "command": "/usr/bin/python3 \"$HOME/.config/cmux/conductor-sidebar/adapter.py\" --notification",
        "timeoutSeconds": 120
      }
    ]
  },
  "actions": {
    "toggleTabBars": {
      "type": "setting",
      "title": "Toggle Tab Bars",
      "path": "app.tabBarVisibility",
      "cycle": [
        "always",
        "multiple-tabs"
      ],
      "shortcut": [
        "ctrl+x",
        "t"
      ]
    }
  }
}
